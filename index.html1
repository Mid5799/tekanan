    /* =========================================================================
       INDEXEDDB STORAGE FOR ORIGINAL EXTRACTED IMAGES (No size limit issues)
       ========================================================================= */
    const DB_NAME = 'FizikTekananOriginalImagesDB';
    const STORE_NAME = 'originalImages';
    let dbInstance = null;
    let extractedImagesMap = Object.assign({}, window.EMBEDDED_ORIGINAL_IMAGES);
    let fullPdfPagesMap = {};
    let loadedPdfDocument = null;
    let showingFullPageMode = false;

    function openImageDB() {
      return new Promise((resolve, reject) => {
        if (dbInstance) return resolve(dbInstance);
        const req = indexedDB.open(DB_NAME, 1);
        req.onupgradeneeded = (e) => {
          const db = e.target.result;
          if (!db.objectStoreNames.contains(STORE_NAME)) {
            db.createObjectStore(STORE_NAME);
          }
        };
        req.onsuccess = (e) => {
          dbInstance = e.target.result;
          resolve(dbInstance);
        };
        req.onerror = () => resolve(null);
      });
    }

    async function saveImageToDB(key, dataUrl) {
      extractedImagesMap[key] = dataUrl;
      const db = await openImageDB();
      if (!db) return;
      return new Promise((resolve) => {
        const tx = db.transaction(STORE_NAME, 'readwrite');
        tx.objectStore(STORE_NAME).put(dataUrl, String(key));
        tx.oncomplete = () => resolve();
        tx.onerror = () => resolve();
      });
    }

    async function loadAllImagesFromDB() {
      const db = await openImageDB();
      if (!db) return;
      return new Promise((resolve) => {
        const tx = db.transaction(STORE_NAME, 'readonly');
        const store = tx.objectStore(STORE_NAME);
        const req = store.openCursor();
        req.onsuccess = (e) => {
          const cursor = e.target.result;
          if (cursor) {
            extractedImagesMap[cursor.key] = cursor.value;
            cursor.continue();
          } else {
            resolve();
          }
        };
        req.onerror = () => resolve();
      });
    }

    /* =========================================================================
       PDF.JS AUTOMATIC ORIGINAL DIAGRAM EXTRACTOR (ZERO REDRAWING)
       ========================================================================= */
    function handleDragOver(e) {
      e.preventDefault();
    }

    function handleDrop(e) {
      e.preventDefault();
      if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
        const file = e.dataTransfer.files[0];
        if (file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf')) {
          processPdfFile(file);
        } else if (file.type.startsWith('image/')) {
          readDirectImageFile(file);
        }
      }
    }

    function handlePdfFileSelect(e) {
      const file = e.target.files[0];
      if (file) processPdfFile(file);
    }

    async function processPdfFile(file) {
      try {
        const progWrap = document.getElementById('extractionProgressWrap');
        const progBar = document.getElementById('extractionProgressBar');
        const statusTxt = document.getElementById('extractionStatusText');
        progWrap.classList.remove('hidden');
        progBar.style.width = '5%';
        statusTxt.innerText = `Membaca fail asal ${file.name}...`;

        const arrayBuffer = await file.arrayBuffer();
        loadedPdfDocument = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
        const numPages = loadedPdfDocument.numPages;

        // Render pages and crop original diagrams verbatim
        const pageCanvases = {};
        for (let p = 1; p <= numPages; p++) {
          const pct = Math.round((p / numPages) * 85);
          progBar.style.width = `${pct}%`;
          statusTxt.innerText = `Mengekstrak imej asal halaman ${p} daripada ${numPages}...`;

          const page = await loadedPdfDocument.getPage(p);
          const viewport = page.getViewport({ scale: 2.2 }); // High-res original scan fidelity
          const canvas = document.createElement('canvas');
          canvas.width = viewport.width;
          canvas.height = viewport.height;
          const ctx = canvas.getContext('2d');
          await page.render({ canvasContext: ctx, viewport }).promise;
          pageCanvases[p] = canvas;

          // Save full page image for optional full-page inspection
          const fullDataUrl = canvas.toDataURL('image/jpeg', 0.88);
          fullPdfPagesMap[p] = fullDataUrl;
          await saveImageToDB(`page_${p}`, fullDataUrl);
        }

        // Crop each question's exact diagram region from the rendered PDF page
        for (const q of questions) {
          if (q.hasDiagram && q.crop && pageCanvases[q.crop.page]) {
            const srcCanvas = pageCanvases[q.crop.page];
            const sx = Math.max(0, Math.floor(q.crop.x * srcCanvas.width));
            const sy = Math.max(0, Math.floor(q.crop.y * srcCanvas.height));
            const sw = Math.min(srcCanvas.width - sx, Math.floor(q.crop.w * srcCanvas.width));
            const sh = Math.min(srcCanvas.height - sy, Math.floor(q.crop.h * srcCanvas.height));

            const cropCanvas = document.createElement('canvas');
            cropCanvas.width = sw;
            cropCanvas.height = sh;
            const cropCtx = cropCanvas.getContext('2d');
            cropCtx.drawImage(srcCanvas, sx, sy, sw, sh, 0, 0, sw, sh);

            const croppedDataUrl = cropCanvas.toDataURL('image/png');
            await saveImageToDB(`q_${q.id}`, croppedDataUrl);
          }
        }

        progBar.style.width = '100%';
        statusTxt.innerText = `Selesai! Kesemua 35 rajah asal berjaya diekstrak 100% tanpa lukisan semula.`;
        updateBannerAfterExtraction();
        renderCurrentQuestion();
      } catch (err) {
        showCustomDialog("Ralat Memuatkan PDF", "Gagal membaca fail PDF. Sila pastikan anda memilih fail TEKANAN.pdf yang sah.");
      }
    }

    function updateBannerAfterExtraction() {
      const hasExtracted = Object.keys(extractedImagesMap).some(k => k.startsWith('q_'));
      const banner = document.getElementById('pdfExtractorBanner');
      const btnExport = document.getElementById('btnExportHtml');

      if (hasExtracted) {
        banner.className = "bg-emerald-50 dark:bg-emerald-950/40 border-b border-emerald-200 dark:border-emerald-800/70 py-2 px-4 transition-all";
        document.getElementById('bannerTitleText').innerText = "✓ Semua Imej & Rajah Asal TEKANAN.pdf Telah Dimuatkan (100% Asal)";
        document.getElementById('bannerSubText').innerText = "Anda boleh melaraskan kawasan keratan mana-mana rajah dengan butang 'Laras Keratan PDF Asal' atau memuat turun fail HTML lengkap.";
        btnExport.classList.remove('hidden');
        btnExport.classList.add('flex');
      }
    }

    /* =========================================================================
       INTERACTIVE ORIGINAL PDF CROP ADJUSTER & DIRECT PASTE/UPLOAD
       ========================================================================= */
    let cropModalCurrentPage = 1;
    let isDraggingCrop = false;
    let cropStartPt = { x: 0, y: 0 };
    let cropEndPt = { x: 0, y: 0 };

    function openCropAdjusterModal() {
      const activeList = getFilteredQuestions();
      const q = activeList[currentQuestionIndex];
      cropModalCurrentPage = (q.crop && q.crop.page) ? q.crop.page : 1;

      const modal = document.getElementById('cropAdjusterModal');
      modal.classList.remove('hidden');
      renderCropModalPage();
    }

    function closeCropAdjusterModal() {
      document.getElementById('cropAdjusterModal').classList.add('hidden');
    }

    function changeCropModalPage(delta) {
      const nextP = cropModalCurrentPage + delta;
      if (nextP >= 1 && nextP <= 24) {
        cropModalCurrentPage = nextP;
        renderCropModalPage();
      }
    }

    function renderCropModalPage() {
      document.getElementById('cropModalPageNum').innerText = `${cropModalCurrentPage} / 24`;
      const canvas = document.getElementById('cropModalPdfCanvas');
      const ctx = canvas.getContext('2d');
      const pageDataUrl = extractedImagesMap[`page_${cropModalCurrentPage}`] || fullPdfPagesMap[cropModalCurrentPage];

      if (!pageDataUrl) {
        showCustomDialog("Muat Naik TEKANAN.pdf Dahulu", "Sila muat naik fail TEKANAN.pdf terlebih dahulu untuk memaparkan halaman asal PDF.");
        closeCropAdjusterModal();
        return;
      }

      const img = new Image();
      img.onload = () => {
        canvas.width = img.width;
        canvas.height = img.height;
        ctx.drawImage(img, 0, 0);
        document.getElementById('cropSelectionBox').classList.add('hidden');
      };
      img.src = pageDataUrl;
    }

    // Mouse / Touch events on cropTouchOverlay
    const overlay = document.getElementById('cropTouchOverlay');
    overlay.addEventListener('mousedown', (e) => {
      const rect = overlay.getBoundingClientRect();
      isDraggingCrop = true;
      cropStartPt = { x: e.clientX - rect.left, y: e.clientY - rect.top };
      cropEndPt = { ...cropStartPt };
      updateCropSelectionBoxUI();
    });
    overlay.addEventListener('mousemove', (e) => {
      if (!isDraggingCrop) return;
      const rect = overlay.getBoundingClientRect();
      cropEndPt = {
        x: Math.max(0, Math.min(rect.width, e.clientX - rect.left)),
        y: Math.max(0, Math.min(rect.height, e.clientY - rect.top))
      };
      updateCropSelectionBoxUI();
    });
    window.addEventListener('mouseup', () => {
      isDraggingCrop = false;
    });

    function updateCropSelectionBoxUI() {
      const box = document.getElementById('cropSelectionBox');
      const left = Math.min(cropStartPt.x, cropEndPt.x);
      const top = Math.min(cropStartPt.y, cropEndPt.y);
      const width = Math.abs(cropEndPt.x - cropStartPt.x);
      const height = Math.abs(cropEndPt.y - cropStartPt.y);
      box.style.left = `${left}px`;
      box.style.top = `${top}px`;
      box.style.width = `${width}px`;
      box.style.height = `${height}px`;
      box.classList.remove('hidden');
    }

    async function applyCustomPdfCrop() {
      const overlayRect = overlay.getBoundingClientRect();
      const canvas = document.getElementById('cropModalPdfCanvas');
      const left = Math.min(cropStartPt.x, cropEndPt.x);
      const top = Math.min(cropStartPt.y, cropEndPt.y);
      const width = Math.abs(cropEndPt.x - cropStartPt.x);
      const height = Math.abs(cropEndPt.y - cropStartPt.y);

      if (width < 15 || height < 15) {
        showCustomDialog("Kawasan Terlalu Kecil", "Sila seret kotak pilihan pada kawasan rajah asal yang ingin diambil.");
        return;
      }

      const scaleX = canvas.width / overlayRect.width;
      const scaleY = canvas.height / overlayRect.height;

      const sx = Math.floor(left * scaleX);
      const sy = Math.floor(top * scaleY);
      const sw = Math.floor(width * scaleX);
      const sh = Math.floor(height * scaleY);

      const outCanvas = document.createElement('canvas');
      outCanvas.width = sw;
      outCanvas.height = sh;
      outCanvas.getContext('2d').drawImage(canvas, sx, sy, sw, sh, 0, 0, sw, sh);

      const activeList = getFilteredQuestions();
      const q = activeList[currentQuestionIndex];
      const dataUrl = outCanvas.toDataURL('image/png');
      await saveImageToDB(`q_${q.id}`, dataUrl);

      showingFullPageMode = false;
      closeCropAdjusterModal();
      renderCurrentQuestion();
    }

    function toggleFullPdfPageView() {
      showingFullPageMode = !showingFullPageMode;
      renderCurrentQuestion();
    }

    function triggerDirectImageUpload() {
      document.getElementById('singleImageInput').click();
    }

    function handleSingleImageUpload(e) {
      const file = e.target.files[0];
      if (file) readDirectImageFile(file);
    }

    function readDirectImageFile(file) {
      const reader = new FileReader();
      reader.onload = async (ev) => {
        const activeList = getFilteredQuestions();
        const q = activeList[currentQuestionIndex];
        await saveImageToDB(`q_${q.id}`, ev.target.result);
        showingFullPageMode = false;
        renderCurrentQuestion();
      };
      reader.readAsDataURL(file);
    }

    // Support Ctrl+V direct image paste onto any question
    window.addEventListener('paste', (e) => {
      if (!e.clipboardData || !e.clipboardData.items) return;
      for (const item of e.clipboardData.items) {
        if (item.type.indexOf('image') !== -1) {
          const file = item.getAsFile();
          if (file) readDirectImageFile(file);
          break;
        }
      }
    });

    /* =========================================================================
       STANDALONE HTML EXPORT WITH EMBEDDED ORIGINAL IMAGES
       ========================================================================= */
    function exportStandaloneHTML() {
      // Embed only question crops (q_1..q_40) to keep file fast and self-contained
      const cleanEmbed = {};
      questions.forEach(q => {
        if (extractedImagesMap[`q_${q.id}`]) {
          cleanEmbed[`q_${q.id}`] = extractedImagesMap[`q_${q.id}`];
        }
      });

      let htmlSource = document.documentElement.outerHTML;
      const scriptInjection = `window.EMBEDDED_ORIGINAL_IMAGES = ${JSON.stringify(cleanEmbed)};`;
      htmlSource = htmlSource.replace(
        'window.EMBEDDED_ORIGINAL_IMAGES = window.EMBEDDED_ORIGINAL_IMAGES || {};',
        scriptInjection
      );

      const blob = new Blob(['<!DOCTYPE html>\n' + htmlSource], { type: 'text/html' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'Modul_Interaktif_Tekanan_Rajah_Asal.html';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    /* =========================================================================
       QUIZ STATE & NAVIGATION LOGIC
       ========================================================================= */
    let currentQuestionIndex = 0;
    let quizMode = 'practice';
    let currentFilterTopic = 'ALL';
    let userAnswers = {};
    let checkedStatus = {};
    let bookmarkedQs = {};
    let examTimeRemaining = 60 * 60;
    let examTimerInterval = null;
    let isExamFinished = false;

    const subtopics = [
      "Tekanan Cecair",
      "Tekanan Gas & Atmosfera",
      "Prinsip Pascal",
      "Prinsip Archimedes",
      "Prinsip Bernoulli"
    ];

    function saveStudentInfo() {
      const info = {
        name: document.getElementById('studentName').value,
        id: document.getElementById('studentID').value,
        mrsm: document.getElementById('studentMRSM').value
      };
      localStorage.setItem('fizik_tekanan_student', JSON.stringify(info));
    }

    function loadSavedState() {
      try {
        const savedAns = localStorage.getItem('fizik_tekanan_userAnswers');
        const savedBookmarks = localStorage.getItem('fizik_tekanan_bookmarks');
        const savedStudent = localStorage.getItem('fizik_tekanan_student');
        if (savedAns) userAnswers = JSON.parse(savedAns);
        if (savedBookmarks) bookmarkedQs = JSON.parse(savedBookmarks);
        if (savedStudent) {
          const s = JSON.parse(savedStudent);
          document.getElementById('studentName').value = s.name || '';
          document.getElementById('studentID').value = s.id || '';
          document.getElementById('studentMRSM').value = s.mrsm || '';
        }
      } catch (e) {}
    }

    function saveState() {
      try {
        localStorage.setItem('fizik_tekanan_userAnswers', JSON.stringify(userAnswers));
        localStorage.setItem('fizik_tekanan_bookmarks', JSON.stringify(bookmarkedQs));
      } catch (e) {}
    }

    function setQuizMode(mode) {
      quizMode = mode;
      const btnPractice = document.getElementById('btnPracticeMode');
      const btnExam = document.getElementById('btnExamMode');
      const timerBadge = document.getElementById('examTimerBadge');
      const btnCheck = document.getElementById('btnCheckAnswer');
      const btnFinish = document.getElementById('btnFinishExam');

      if (mode === 'practice') {
        btnPractice.className = "px-2.5 py-1 rounded-lg bg-white dark:bg-slate-700 text-blue-700 dark:text-blue-300 shadow-sm transition";
        btnExam.className = "px-2.5 py-1 rounded-lg text-slate-600 dark:text-slate-300 hover:text-slate-900 transition";
        timerBadge.classList.add('hidden');
        btnCheck.classList.remove('hidden');
        btnFinish.classList.add('hidden');
        clearInterval(examTimerInterval);
      } else {
        btnExam.className = "px-2.5 py-1 rounded-lg bg-white dark:bg-slate-700 text-blue-700 dark:text-blue-300 shadow-sm transition";
        btnPractice.className = "px-2.5 py-1 rounded-lg text-slate-600 dark:text-slate-300 hover:text-slate-900 transition";
        timerBadge.classList.remove('hidden');
        timerBadge.classList.add('flex');
        btnCheck.classList.add('hidden');
        btnFinish.classList.remove('hidden');
        startExamTimer();
      }
      renderCurrentQuestion();
      updatePaletteUI();
    }

    function startExamTimer() {
      clearInterval(examTimerInterval);
      examTimerInterval = setInterval(() => {
        if (examTimeRemaining > 0) {
          examTimeRemaining--;
          const m = Math.floor(examTimeRemaining / 60);
          const s = examTimeRemaining % 60;
          document.getElementById('timerDisplay').innerText = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
        } else {
          clearInterval(examTimerInterval);
          submitExam();
        }
      }, 1000);
    }

    function getFilteredQuestions() {
      if (currentFilterTopic === 'ALL') return questions;
      return questions.filter(q => q.topic === currentFilterTopic);
    }

    function filterByTopic(topic) {
      currentFilterTopic = topic;
      document.querySelectorAll('.topic-tab-btn').forEach(btn => {
        btn.className = "topic-tab-btn px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 whitespace-nowrap";
      });
      const activeBtn = topic === 'ALL' ? document.getElementById('tabTopicALL') :
        document.getElementById(`tabTopic${subtopics.indexOf(topic) + 1}`);
      if (activeBtn) {
        activeBtn.className = "topic-tab-btn px-2.5 py-1 rounded-full bg-slate-900 text-white dark:bg-blue-600 font-semibold whitespace-nowrap";
      }

      document.getElementById('filteredIndicator').innerText = topic === 'ALL' ? 'Semua (40)' : topic;
      currentQuestionIndex = 0;
      buildPaletteGrid();
      renderCurrentQuestion();
    }

    function renderCurrentQuestion() {
      const activeList = getFilteredQuestions();
      if (activeList.length === 0) return;
      if (currentQuestionIndex >= activeList.length) currentQuestionIndex = 0;

      const q = activeList[currentQuestionIndex];
      const qId = q.id;

      document.getElementById('badgeCurrentQNum').innerText = qId;
      document.getElementById('currentRajahNumber').innerText = q.rajahNo;
      document.getElementById('currentCategoryTitle').innerText = q.topic;
      document.getElementById('progressText').innerText = `${currentQuestionIndex + 1}/${activeList.length}`;
      document.getElementById('progressBar').style.width = `${((currentQuestionIndex + 1) / activeList.length) * 100}%`;

      document.getElementById('qTextBM').innerHTML = `${qId}. ${q.questionBM}`;
      document.getElementById('qTextBI').innerHTML = q.questionBI;

      // Strictly Original Image Handling (NO Redrawn SVGs)
      const diagWrapper = document.getElementById('diagramWrapper');
      const imgEl = document.getElementById('originalQuestionImg');
      const placeholderEl = document.getElementById('unloadedDiagramPlaceholder');
      const btnCrop = document.getElementById('btnOpenCropModal');
      const btnFull = document.getElementById('btnToggleFullPage');
      const sourceLabel = document.getElementById('diagramSourceLabel');

      const customOrExtractedImg = showingFullPageMode && q.crop && extractedImagesMap[`page_${q.crop.page}`]
        ? extractedImagesMap[`page_${q.crop.page}`]
        : extractedImagesMap[`q_${qId}`];

      if (q.hasDiagram || customOrExtractedImg) {
        diagWrapper.classList.remove('hidden');
        sourceLabel.innerHTML = `<i class="fa-regular fa-image mr-1"></i> ${q.rajahNo} ${showingFullPageMode ? '(Halaman Penuh Asal)' : '(Rajah Asal)'}`;

        if (customOrExtractedImg) {
          imgEl.src = customOrExtractedImg;
          imgEl.classList.remove('hidden');
          placeholderEl.classList.add('hidden');
          if (q.crop && extractedImagesMap[`page_${q.crop.page}`]) {
            btnCrop.classList.remove('hidden');
            btnFull.classList.remove('hidden');
          }
        } else {
          imgEl.classList.add('hidden');
          placeholderEl.classList.remove('hidden');
          document.getElementById('placeholderTitle').innerText = `Rajah Asal Soalan ${qId} (${q.rajahNo})`;
          btnCrop.classList.add('hidden');
          btnFull.classList.add('hidden');
        }
      } else {
        diagWrapper.classList.add('hidden');
      }

      // Bookmark button state
      const btnBm = document.getElementById('btnBookmark');
      if (bookmarkedQs[qId]) {
        btnBm.innerHTML = '<i class="fa-solid fa-bookmark text-amber-500"></i> Disimpan';
        btnBm.className = "p-2 rounded-lg border border-amber-300 bg-amber-50 dark:bg-amber-950/40 text-amber-600 text-xs flex items-center gap-1.5 font-bold";
      } else {
        btnBm.innerHTML = '<i class="fa-regular fa-bookmark"></i> Simpan';
        btnBm.className = "p-2 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-400 hover:text-amber-500 transition text-xs flex items-center gap-1.5 font-semibold";
      }

      // Options rendering
      const optionsContainer = document.getElementById('optionsList');
      optionsContainer.innerHTML = '';
      const selected = userAnswers[qId];
      const isChecked = (quizMode === 'practice' && checkedStatus[qId]) || isExamFinished;

      q.options.forEach(opt => {
        const btn = document.createElement('button');
        btn.onclick = () => selectOption(qId, opt.key);

        let baseStyle = "w-full text-left p-3.5 rounded-xl border flex items-center gap-3 transition-all-custom cursor-pointer ";
        let badgeStyle = "w-7 h-7 rounded-lg flex items-center justify-center font-bold text-xs shrink-0 ";

        if (!isChecked) {
          if (selected === opt.key) {
            baseStyle += "border-blue-600 bg-blue-50/80 dark:bg-blue-900/30 text-blue-950 dark:text-blue-100 ring-2 ring-blue-500/20";
            badgeStyle += "bg-blue-600 text-white shadow";
          } else {
            baseStyle += "border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100";
            badgeStyle += "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300";
          }
        } else {
          if (opt.key === q.answer) {
            baseStyle += "border-emerald-500 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-950 dark:text-emerald-100 ring-2 ring-emerald-500/20 font-medium";
            badgeStyle += "bg-emerald-600 text-white";
          } else if (selected === opt.key && selected !== q.answer) {
            baseStyle += "border-rose-500 bg-rose-50 dark:bg-rose-950/40 text-rose-950 dark:text-rose-100 ring-2 ring-rose-500/20";
            badgeStyle += "bg-rose-600 text-white";
          } else {
            baseStyle += "border-slate-200 dark:border-slate-800 opacity-55 bg-white dark:bg-slate-900 text-slate-500";
            badgeStyle += "bg-slate-100 dark:bg-slate-800 text-slate-400";
          }
        }

        btn.className = baseStyle;
        btn.innerHTML = `
          <span class="${badgeStyle}">${opt.key}</span>
          <div class="flex-1">
            <span class="block text-xs sm:text-sm font-semibold">${opt.bm}</span>
            ${opt.bi ? `<span class="block text-[11px] italic text-slate-500 dark:text-slate-400">${opt.bi}</span>` : ''}
          </div>
          ${isChecked && opt.key === q.answer ? '<i class="fa-solid fa-circle-check text-emerald-600 text-base ml-auto"></i>' : ''}
          ${isChecked && selected === opt.key && selected !== q.answer ? '<i class="fa-solid fa-circle-xmark text-rose-600 text-base ml-auto"></i>' : ''}
        `;
        optionsContainer.appendChild(btn);
      });

      // Explanation Container
      const expBox = document.getElementById('explanationContainer');
      const expBadge = document.getElementById('explanationBadge');
      const expContent = document.getElementById('explanationContent');

      if (isChecked) {
        expBox.classList.remove('hidden');
        expBox.classList.add('flex');
        const isCorrect = (selected === q.answer);
        if (isCorrect) {
          expBox.className = "flex flex-col gap-2 p-4 rounded-xl border border-emerald-300 dark:border-emerald-800 bg-emerald-50/60 dark:bg-emerald-950/30";
          expBadge.className = "px-2 py-0.5 text-xs font-bold rounded bg-emerald-200 text-emerald-900 dark:bg-emerald-900/60 dark:text-emerald-200";
          expBadge.innerHTML = '<i class="fa-solid fa-check mr-1"></i> Jawapan Tepat';
        } else {
          expBox.className = "flex flex-col gap-2 p-4 rounded-xl border border-rose-300 dark:border-rose-800 bg-rose-50/60 dark:bg-rose-950/30";
          expBadge.className = "px-2 py-0.5 text-xs font-bold rounded bg-rose-200 text-rose-900 dark:bg-rose-900/60 dark:text-rose-200";
          expBadge.innerHTML = `<i class="fa-solid fa-xmark mr-1"></i> Kurang Tepat (Jawapan Betul: ${q.answer})`;
        }
        expContent.innerHTML = q.explanation;
      } else {
        expBox.classList.add('hidden');
      }

      document.getElementById('btnPrev').disabled = (currentQuestionIndex === 0);
      document.getElementById('btnNext').disabled = (currentQuestionIndex === activeList.length - 1);

      updatePaletteUI();
      updateTopicOverview();
    }

    function selectOption(qId, key) {
      if (isExamFinished && quizMode === 'exam') return;
      userAnswers[qId] = key;
      saveState();
      renderCurrentQuestion();
    }

    function checkCurrentAnswer() {
      const activeList = getFilteredQuestions();
      const q = activeList[currentQuestionIndex];
      if (!userAnswers[q.id]) {
        showCustomDialog("Pilih Jawapan Dahulu", "Sila pilih salah satu pilihan jawapan sebelum menyemak.");
        return;
      }
      checkedStatus[q.id] = true;
      renderCurrentQuestion();
    }

    function toggleBookmarkCurrent() {
      const activeList = getFilteredQuestions();
      const q = activeList[currentQuestionIndex];
      bookmarkedQs[q.id] = !bookmarkedQs[q.id];
      saveState();
      renderCurrentQuestion();
    }

    function navigateQuestion(delta) {
      const activeList = getFilteredQuestions();
      const newIdx = currentQuestionIndex + delta;
      if (newIdx >= 0 && newIdx < activeList.length) {
        currentQuestionIndex = newIdx;
        showingFullPageMode = false;
        renderCurrentQuestion();
      }
    }

    function buildPaletteGrid() {
      const grid = document.getElementById('paletteGrid');
      grid.innerHTML = '';
      const activeList = getFilteredQuestions();

      activeList.forEach((q, idx) => {
        const btn = document.createElement('button');
        btn.id = `palette-btn-${q.id}`;
        btn.innerText = q.id;
        btn.onclick = () => {
          currentQuestionIndex = idx;
          showingFullPageMode = false;
          renderCurrentQuestion();
        };
        btn.className = "h-8 w-full rounded font-mono text-xs font-bold flex items-center justify-center border transition";
        grid.appendChild(btn);
      });
      updatePaletteUI();
    }

    function updatePaletteUI() {
      const activeList = getFilteredQuestions();
      activeList.forEach((q, idx) => {
        const btn = document.getElementById(`palette-btn-${q.id}`);
        if (!btn) return;
        const ans = userAnswers[q.id];
        const isChecked = (quizMode === 'practice' && checkedStatus[q.id]) || isExamFinished;
        const isCurrent = (idx === currentQuestionIndex);

        let style = "h-8 w-full rounded font-mono text-xs font-bold flex items-center justify-center border transition ";

        if (isCurrent) {
          style += "ring-2 ring-blue-600 border-blue-600 bg-blue-600 text-white shadow";
        } else if (isChecked) {
          if (ans === q.answer) style += "bg-emerald-600 text-white border-emerald-700";
          else style += "bg-rose-600 text-white border-rose-700";
        } else if (ans) {
          style += "bg-blue-100 dark:bg-blue-900/60 text-blue-900 dark:text-blue-200 border-blue-300 dark:border-blue-700";
        } else {
          style += "bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border-slate-200 dark:border-slate-700 hover:bg-slate-100";
        }

        btn.className = style;
      });

      const answeredTotal = Object.keys(userAnswers).length;
      document.getElementById('statSummaryCompact').innerText = `${answeredTotal}/40 Dijawab`;
    }

    function updateTopicOverview() {
      const container = document.getElementById('topicProgressBarContainer');
      container.innerHTML = '';

      subtopics.forEach(topic => {
        const topicQs = questions.filter(q => q.topic === topic);
        const answeredInTopic = topicQs.filter(q => userAnswers[q.id]).length;
        const pct = Math.round((answeredInTopic / topicQs.length) * 100);

        const row = document.createElement('div');
        row.className = "space-y-1";
        row.innerHTML = `
          <div class="flex justify-between text-[11px] text-slate-600 dark:text-slate-400">
            <span>${topic}</span>
            <span class="font-mono font-bold">${answeredInTopic}/${topicQs.length}</span>
          </div>
          <div class="w-full bg-slate-200 dark:bg-slate-800 h-1.5 rounded-full overflow-hidden">
            <div class="bg-blue-600 h-full rounded-full transition-all duration-300" style="width: ${pct}%"></div>
          </div>
        `;
        container.appendChild(row);
      });
    }

    /* =========================================================================
       CUSTOM DIALOGS & EXAM SUBMISSION
       ========================================================================= */
    function showCustomDialog(title, message, onConfirm = null) {
      document.getElementById('dialogTitle').innerText = title;
      document.getElementById('dialogMessage').innerText = message;
      const btnCancel = document.getElementById('dialogBtnCancel');
      const btnConfirm = document.getElementById('dialogBtnConfirm');

      if (onConfirm) {
        btnCancel.classList.remove('hidden');
        btnConfirm.onclick = () => {
          closeCustomDialog();
          onConfirm();
        };
      } else {
        btnCancel.classList.add('hidden');
        btnConfirm.onclick = closeCustomDialog;
      }

      document.getElementById('customDialogModal').classList.remove('hidden');
    }

    function closeCustomDialog() {
      document.getElementById('customDialogModal').classList.add('hidden');
    }

    function openResetConfirmModal() {
      showCustomDialog(
        "Reset Semua Jawapan?",
        "Adakah anda pasti mahu memadamkan semua pilihan jawapan anda untuk memulakan semula latihan?",
        () => {
          userAnswers = {};
          checkedStatus = {};
          isExamFinished = false;
          saveState();
          renderCurrentQuestion();
        }
      );
    }

    function confirmSubmitExam() {
      const unanswered = questions.filter(q => !userAnswers[q.id]).length;
      let msg = "Adakah anda bersedia untuk menghantar jawapan ujian anda?";
      if (unanswered > 0) msg += ` (Masih terdapat ${unanswered} soalan yang belum dijawab).`;
      showCustomDialog("Hantar Kertas Ujian", msg, submitExam);
    }

    function submitExam() {
      clearInterval(examTimerInterval);
      isExamFinished = true;

      let correct = 0;
      let topicBreakdown = {};
      subtopics.forEach(t => topicBreakdown[t] = { total: 0, correct: 0 });

      questions.forEach(q => {
        topicBreakdown[q.topic].total++;
        if (userAnswers[q.id] === q.answer) {
          correct++;
          topicBreakdown[q.topic].correct++;
        }
      });

      const percentage = Math.round((correct / questions.length) * 100);
      let grade = 'G';
      if (percentage >= 85) grade = 'A+';
      else if (percentage >= 75) grade = 'A';
      else if (percentage >= 70) grade = 'A-';
      else if (percentage >= 65) grade = 'B+';
      else if (percentage >= 60) grade = 'B';
      else if (percentage >= 50) grade = 'C';
      else if (percentage >= 40) grade = 'D';

      const sName = document.getElementById('studentName').value || 'Pelajar';
      const sID = document.getElementById('studentID').value || '-';
      const sMRSM = document.getElementById('studentMRSM').value || '-';
      document.getElementById('resultStudentInfo').innerText = `${sName} (${sID}) • MRSM ${sMRSM}`;

      document.getElementById('finalScoreVal').innerText = `${correct}/40`;
      document.getElementById('finalPercentage').innerText = `${percentage}%`;
      document.getElementById('finalGrade').innerText = grade;

      const resDiv = document.getElementById('subtopicResults');
      resDiv.innerHTML = '';
      subtopics.forEach(t => {
        const item = topicBreakdown[t];
        const pct = item.total > 0 ? Math.round((item.correct / item.total) * 100) : 0;
        const row = document.createElement('div');
        row.className = "p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-between";
        row.innerHTML = `
          <div>
            <div class="font-bold text-slate-800 dark:text-slate-200">${t}</div>
            <div class="text-[11px] text-slate-500">${item.correct}/${item.total} betul</div>
          </div>
          <span class="font-mono font-bold ${pct >= 70 ? 'text-emerald-600' : 'text-amber-500'}">${pct}%</span>
        `;
        resDiv.appendChild(row);
      });

      document.getElementById('resultsModal').classList.remove('hidden');
      renderCurrentQuestion();
    }

    function closeResultsModal() {
      document.getElementById('resultsModal').classList.add('hidden');
    }

    function resetAndRestartExam() {
      closeResultsModal();
      userAnswers = {};
      checkedStatus = {};
      isExamFinished = false;
      examTimeRemaining = 60 * 60;
      saveState();
      setQuizMode('exam');
      currentQuestionIndex = 0;
      renderCurrentQuestion();
    }

    function toggleFormulaModal() {
      document.getElementById('formulaModal').classList.toggle('hidden');
    }

    function toggleDarkMode() {
      const html = document.documentElement;
      const icon = document.getElementById('themeIcon');
      if (html.classList.contains('dark')) {
        html.classList.remove('dark');
        icon.className = 'fa-solid fa-moon text-sm';
        localStorage.setItem('fizik_theme', 'light');
      } else {
        html.classList.add('dark');
        icon.className = 'fa-solid fa-sun text-amber-400 text-sm';
        localStorage.setItem('fizik_theme', 'dark');
      }
    }

    window.onload = async function() {
      if (localStorage.getItem('fizik_theme') === 'dark') {
        document.documentElement.classList.add('dark');
        document.getElementById('themeIcon').className = 'fa-solid fa-sun text-amber-400 text-sm';
      }
      loadSavedState();
      await loadAllImagesFromDB();
      updateBannerAfterExtraction();
      buildPaletteGrid();
      setQuizMode('practice');
      renderCurrentQuestion();
    };
  </script>
</body>
</html>
